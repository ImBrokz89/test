local function ReplayDungeon()
    print("🔄 Lancement du Auto Replay...")
    
    local dungeonInfo = GetDungeonInfo()
    
    print("📋 Infos du donjon:")
    print("  📌 Nom:", dungeonInfo.dungeonName)
    print("  📌 Progression:", dungeonInfo.dungeonProgress)
    print("  📌 Dungeon Started:", dungeonInfo.dungeonStarted)
    print("  📌 Dungeon Finished:", dungeonInfo.dungeonFinished)
    print("  📌 Hardcore:", dungeonInfo.isHardcore)
    
    local shouldReplay = false
    
    if dungeonInfo.dungeonProgress == "bossKilled" then
        print("✅ Boss tué ! Auto Replay déclenché.")
        shouldReplay = true
    elseif dungeonInfo.dungeonProgress == "hardcoreFailed" then
        print("💀 Hardcore échoué ! Auto Replay déclenché.")
        shouldReplay = true
    elseif dungeonInfo.dungeonFinished == true then
        print("✅ Donjon terminé ! Auto Replay déclenché.")
        shouldReplay = true
    end
    
    if not shouldReplay then
        print("⏭️ Donjon pas encore fini, pas de replay.")
        return
    end
    
    if not IsReplayButtonVisible() then
        print("⚠️ Bouton Replay non visible, impossible de lancer le replay.")
        return
    end
    
    print("🟢 Bouton Replay visible ! Lancement...")
    
    local replayData = {
        dungeonProgress = dungeonInfo.dungeonProgress,
        dungeonStarted = dungeonInfo.dungeonStarted,
        hardcore = dungeonInfo.isHardcore,
        dungeonFinished = dungeonInfo.dungeonFinished,
        dungeonName = dungeonInfo.dungeonName,
        isHardcore = dungeonInfo.isHardcore,
        fightingBoss = false
    }
    
    local Event = ReplicatedStorage:FindFirstChild("remotes")
    if Event then
        local replayEvent = Event:FindFirstChild("replayDungeon")
        if replayEvent then
            pcall(function()
                replayEvent:FireServer(replayData)
                print("✅ Replay envoyé !")
            end)
        else
            print("❌ replayDungeon introuvable")
        end
    end
end

local function StartAutoReplay()
    print("👀 Surveillance Auto Replay activée")
    
    while true do
        if Config.AUTO_REPLAY then
            local dungeonInfo = GetDungeonInfo()
            
            local shouldReplay = false
            
            if dungeonInfo.dungeonProgress == "bossKilled" then
                shouldReplay = true
            elseif dungeonInfo.dungeonProgress == "hardcoreFailed" then
                shouldReplay = true
            elseif dungeonInfo.dungeonFinished == true then
                shouldReplay = true
            end
            
            if shouldReplay then
                if IsReplayButtonVisible() then
                    ReplayDungeon()
                    task.wait(5)
                end
            end
        end
        
        task.wait(2)
    end
end

