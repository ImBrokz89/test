local function SpendSkillPoints()
    local skillPoints = LocalPlayer:FindFirstChild("skillPoints")
    if not skillPoints then 
        print("❌ skillPoints introuvable")
        return 
    end
    
    if skillPoints.Value > 0 then
        print("🔧 Dépense de " .. skillPoints.Value .. " points de compétence")
        
        local Event = ReplicatedStorage:FindFirstChild("remotes")
        if Event then
            local spendEvent = Event:FindFirstChild("spendSkillPoint")
            if spendEvent then
                for i = 1, skillPoints.Value do
                    pcall(function()
                        spendEvent:FireServer("physicalPower", 1)
                        print("✅ Point de compétence dépensé (" .. i .. "/" .. skillPoints.Value .. ")")
                    end)
                    task.wait(0.1)
                end
            else
                print("❌ spendSkillPoint introuvable")
            end
        end
    else
        print("ℹ️ Aucun point de compétence à dépenser")
    end
end

