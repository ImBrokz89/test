local function GetEquippedWeapon()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local weaponValue = LocalPlayer:FindFirstChild("weaponEquipped")
    if weaponValue then
        if weaponValue:IsA("ObjectValue") then
            return weaponValue.Value
        elseif weaponValue:IsA("StringValue") then
            return character:FindFirstChild(weaponValue.Value)
        end
    end
    
    local dualRight = character:FindFirstChild("dualRight")
    if dualRight then
        return dualRight
    end
    
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            local swing = child:FindFirstChild("swing")
            if swing and swing:IsA("RemoteEvent") then
                return child
            end
        end
    end
    
    return nil
end

