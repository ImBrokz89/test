--------------------------------------------------

local function GetHRP(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
end

--------------------------------------------------
-- POSITIONNER LE PERSONNAGE
--------------------------------------------------

local function SetProne(pos, lookPos)
    if not HRP or not HRP.Parent then 
        return 
    end

    local direction = lookPos - pos
    if direction.Magnitude <= 0.01 then 
        return 
    end

    local look = direction.Unit
    local up = Vector3.new(0, 1, 0)
    
    local cf = CFrame.lookAt(pos, pos + look, up)
    
    HRP.CFrame = cf
    HRP.AssemblyLinearVelocity = Vector3.zero
end

--------------------------------------------------
-- RÉCUPÉRER L'ARME ÉQUIPÉE
--------------------------------------------------

local function GetEquippedWeapon()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    -- 1. Chercher via weaponEquipped
    local weaponValue = LocalPlayer:FindFirstChild("weaponEquipped")
    if weaponValue then
        if weaponValue:IsA("ObjectValue") then
            return weaponValue.Value
        elseif weaponValue:IsA("StringValue") then
            return character:FindFirstChild(weaponValue.Value)
        end
    end
    
    -- 2. Chercher "dualRight" directement
    local dualRight = character:FindFirstChild("dualRight")
    if dualRight then
        return dualRight
    end
    
    -- 3. Chercher n'importe quel tool avec "swing"
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            local swing = child:FindFirstChild("swing")
            if swing and swing:IsA("RemoteEvent") then
                return child
            end
        end
    end
    
    return nil
end

--------------------------------------------------
-- ATTAQUE (SWING) - À 10 MÈTRES
--------------------------------------------------

local function SwingWeapon()
    local weapon = GetEquippedWeapon()
    if not weapon then return end
    
    local swing = weapon:FindFirstChild("swing")
    if swing and swing:IsA("RemoteEvent") then
        pcall(function()
            swing:FireServer()
        end)
    end
end

--------------------------------------------------
-- UTILISER LES SORTS - À 10 MÈTRES
--------------------------------------------------

local function UseSpellsDuringSlide(enemyPosition)
    -- Vérifier la distance
    if not HRP or not HRP.Parent then return end
    if not enemyPosition then return end
    
    local distance = (HRP.Position - enemyPosition).Magnitude
    if distance > SWING_RANGE then return end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    
    local abilityUsed = ReplicatedStorage:FindFirstChild("remotes")
    if abilityUsed then
        abilityUsed = abilityUsed:FindFirstChild("abilityUsed")
    end
    if not abilityUsed then return end
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local abilitySlot = tool:FindFirstChild("abilitySlot")
            
            if abilitySlot then
                local slot = string.lower(tostring(abilitySlot.Value))
                
                if slot == "q" or slot == "e" then
                    local cooldown = tool:FindFirstChild("cooldown")
                    local ready = true
                    if cooldown then
                        local value = cooldown.Value
                        if cooldown:IsA("BoolValue") then
                            ready = value == false
                        elseif typeof(value) == "number" then
                            ready = value <= 0
                        end
                    end
                    
                    if ready then
                        pcall(function()
                            abilityUsed:FireServer(slot, tool)
                            
                            local spellEvent = tool:FindFirstChild("spellEvent")
                            if spellEvent and spellEvent:IsA("RemoteEvent") then
                                spellEvent:FireServer()
                            end
                            
                            local abilityEvent = tool:FindFirstChild("abilityEvent")
                            if abilityEvent and abilityEvent:IsA("RemoteEvent") then
                                abilityEvent:FireServer()
                            end
                        end)
                    end
                end
            end
        end
    end
end

--------------------------------------------------
-- SE DÉPLACER VERS L'ENNEMI
--------------------------------------------------

local function SlideTo(enemy, startPos)
    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
    local enemyHRP = GetHRP(enemy)
    
    if not humanoid or humanoid.Health <= 0 then return end
    if not enemyHRP then return end
    if not HRP or not HRP.Parent then return end

    local playerHumanoid = Character:FindFirstChildOfClass("Humanoid")
    if not playerHumanoid then return end
    
    local walkSpeed = SLIDE_SPEED
    local originalWalkSpeed = playerHumanoid.WalkSpeed
    playerHumanoid.WalkSpeed = walkSpeed

    local pos = startPos
    local swingTimer = 0
    local stuckTime = 0
    local heartbeat = RunService.Heartbeat
    local spellTimer = 0
    local spellDelay = 0.15

    while true do
        if not HRP or not HRP.Parent then break end
        
        humanoid = enemy:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then 
            break
        end
        
        enemyHRP = GetHRP(enemy)
        if not enemyHRP then break end
        
        local targetPos = enemyHRP.Position + Vector3.new(0, Offset, 0)
        local distance = (targetPos - pos).Magnitude
        local distanceToEnemy = (HRP.Position - enemyHRP.Position).Magnitude
        
        local dt = heartbeat:Wait()
        
        if distance > 0.5 then
            local speed = walkSpeed * 2.2
            local step = math.min(1, speed * dt / distance)
            pos = pos:Lerp(targetPos, step)
            stuckTime = 0
        else
            stuckTime = stuckTime + dt
        end
        
        SetProne(pos, enemyHRP.Position)
        
        -- ⚔️ Attaque et sorts uniquement si à 10 mètres ou moins
        if distanceToEnemy <= SWING_RANGE then
            swingTimer = swingTimer + dt
            if swingTimer >= SwingDelay then
                SwingWeapon()
                swingTimer = 0
            end
            
            spellTimer = spellTimer + dt
            if spellTimer >= spellDelay then
                UseSpellsDuringSlide(enemyHRP.Position)
                spellTimer = 0
            end
        end
        
        if stuckTime >= 5 then
            break
        end
    end
    
    playerHumanoid.WalkSpeed = originalWalkSpeed
end

--------------------------------------------------
-- BOUCLE PRINCIPALE
--------------------------------------------------

while true do
    local currentChar = LocalPlayer.Character
    if currentChar then
        Character = currentChar
        local newHRP = Character:FindFirstChild("HumanoidRootPart")
        if newHRP then
            HRP = newHRP
        end
    end
    
    if isAttacking or not HRP or not HRP.Parent then
        task.wait(0.5)
        continue
    end
    
    local enemies = GetEnemies()
    
    for _, enemy in ipairs(enemies) do
        if not HRP or not HRP.Parent then break end
        
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local enemyHRP = GetHRP(enemy)
        
        if humanoid and humanoid.Health > 0 and enemyHRP then
            isAttacking = true
            SlideTo(enemy, HRP.Position)
            isAttacking = false
        end
    end
    
    task.wait(0.5)
end
