local function LoadConfigFromWorkspace()
    local config = {
        DUNGEON_NAME = "Pirate Island",
        DUNGEON_DIFFICULTY = "Insane"
    }
    
    local omegaFolder = workspace:FindFirstChild("Omega.Win")
    if not omegaFolder then
        print("⚠️ Dossier Omega.Win introuvable, création...")
        return CreateConfigInWorkspace()
    end
    
    local configFile = omegaFolder:FindFirstChild("Config.json")
    if not configFile then
        print("⚠️ Fichier Config.json introuvable, création...")
        return CreateConfigInWorkspace()
    end
    
    if configFile:IsA("StringValue") then
        local content = configFile.Value
        
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        
        if success and decoded then
            print("✅ Configuration chargée depuis Workspace/Omega.Win/Config.json")
            print("📋 Contenu du fichier:")
            print(content)
            
            if decoded.dungeonName then 
                config.DUNGEON_NAME = decoded.dungeonName 
            end
            if decoded.dungeonDifficulty then 
                config.DUNGEON_DIFFICULTY = decoded.dungeonDifficulty 
            end
            
            print("  📌 Dungeon Name:", config.DUNGEON_NAME)
            print("  📌 Dungeon Difficulty:", config.DUNGEON_DIFFICULTY)
        else
            print("❌ Erreur de lecture du JSON, utilisation des valeurs par défaut")
            print("📝 Contenu actuel du fichier:", content)
        end
    end
    
    return config
end

