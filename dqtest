-- SPELLS
--------------------------------------------------

task.spawn(function()
    local SpellsRemotes = ReplicatedStorage:FindFirstChild("remotes")
    if not SpellsRemotes then 
        print("❌ Remotes introuvable pour les sorts")
        return 
    end
    
    local AbilityUsed = SpellsRemotes:FindFirstChild("abilityUsed")
    if not AbilityUsed then 
        print("❌ abilityUsed introuvable")
        return 
    end

    local function GetSpellTools()
        local spells = {}
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if not backpack then return spells end

        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local abilitySlot = tool:FindFirstChild("abilitySlot")
                local cooldown = tool:FindFirstChild("cooldown")
                local spellEvent = tool:FindFirstChild("spellEvent")

                if abilitySlot and cooldown and spellEvent then
                    table.insert(spells, {
                        Tool = tool,
                        Slot = string.lower(tostring(abilitySlot.Value)),
                        Cooldown = cooldown,
                        SpellEvent = spellEvent
                    })
                end
            end
        end
        return spells
    end

    local function IsReady(cooldown)
        if not cooldown then return false end
        local value = cooldown.Value
        if cooldown:IsA("BoolValue") then
            return value == false
        end
        if typeof(value) == "number" then
            return value <= 0
        end
        return true
    end

    local function UseSpell(spell)
        if not spell then return end
        if not IsReady(spell.Cooldown) then return end
        
        local slot = spell.Slot
        if slot ~= "q" and slot ~= "e" then return end
        
        local currentRemotes = ReplicatedStorage:FindFirstChild("remotes")
        local currentAbility = currentRemotes and currentRemotes:FindFirstChild("abilityUsed")
        
        if currentAbility then
            currentAbility:FireServer(slot, spell.Tool)
        end
        
        if spell.SpellEvent and spell.SpellEvent:IsA("RemoteEvent") then
            spell.SpellEvent:FireServer()
        end
    end

    while true do
        local spells = GetSpellTools()
        for _, spell in ipairs(spells) do
            UseSpell(spell)
        end
        task.wait(0.1)
    end
end)

