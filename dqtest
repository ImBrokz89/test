local CONFIG_FOLDER = "Omega.Win"
local CONFIG_FILE = CONFIG_FOLDER .. "/Config.json"

local function CreateConfigOnDisk()
    print("📁 Création du dossier " .. CONFIG_FOLDER .. "...")
    
    if not FolderExists(CONFIG_FOLDER) then
        local success = CreateFolder(CONFIG_FOLDER)
        if success then
            print("✅ Dossier " .. CONFIG_FOLDER .. " créé")
        else
            print("❌ Impossible de créer le dossier " .. CONFIG_FOLDER)
        end
    else
        print("✅ Dossier " .. CONFIG_FOLDER .. " déjà existant")
    end
    
    local defaultConfig = {
        dungeonName = "Pirate Island",
        dungeonDifficulty = "Insane",
        AutoReplay = false
    }
    
    local jsonString = FormatJSON(defaultConfig)
    
    local success = WriteFile(CONFIG_FILE, jsonString)
    
    if success then
        print("✅ Fichier Config.json créé dans " .. CONFIG_FOLDER)
        print("📝 JSON généré:")
        print(jsonString)
    else
        print("❌ Impossible de créer le fichier Config.json")
    end
    
    print("📋 Configuration par défaut:")
    print("  📌 Dungeon Name:", defaultConfig.dungeonName)
    print("  📌 Dungeon Difficulty:", defaultConfig.dungeonDifficulty)
    print("  📌 AutoReplay:", defaultConfig.AutoReplay)
    
    return {
        DUNGEON_NAME = defaultConfig.dungeonName,
        DUNGEON_DIFFICULTY = defaultConfig.dungeonDifficulty,
        AUTO_REPLAY = defaultConfig.AutoReplay
    }
end

