task.spawn(function()
    print("🔮 Initialisation des sorts...")
    
    local function GetSpellTools()
        local spells = {}
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if not backpack then 
            return spells 
        end

        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local abilitySlot = tool:FindFirstChild("abilitySlot")
                local abilityEvent = tool:FindFirstChild("abilityEvent")
                local cooldown = tool:FindFirstChild("cooldown")
                
                if abilitySlot and abilityEvent then
                    local slot = string.lower(tostring(abilitySlot.Value))
                    
                    if slot == "q" or slot == "e" then
                        table.insert(spells, {
                            Tool = tool,
                            Slot = slot,
                            AbilityEvent = abilityEvent,
                            Cooldown = cooldown,
                            Name = tool.Name
                        })
                        print("🔮 Sort trouvé:", tool.Name, "| Slot:", slot)
                    end
                end
            end
        end
        
        print("📊 Total sorts trouvés (Q/E):", #spells)
        return spells
    end

    local function IsReady(cooldown)
        if not cooldown then return true end
        
        local value = cooldown.Value
        if cooldown:IsA("BoolValue") then
            return value == false
        end
        if typeof(value) == "number" then
            return value <= 0
        end
        return true
    end

    local function UseSpell(spell)
        if not spell then return end
        if not IsReady(spell.Cooldown) then 
            return 
        end
        
        if spell.AbilityEvent and spell.AbilityEvent:IsA("RemoteEvent") then
            pcall(function()
                spell.AbilityEvent:FireServer()
                print("⚡ Sort utilisé:", spell.Name, "| Slot:", spell.Slot)
            end)
        end
    end

    while true do
        local spells = GetSpellTools()
        for _, spell in ipairs(spells) do
            UseSpell(spell)
        end
        task.wait(0.15)
    end
end)

--------------------------------------------------
-- BOUCLE PRINCIPALE
--------------------------------------------------

while true do
    local currentChar = LocalPlayer.Character
    if currentChar then
        Character = currentChar
        local newHRP = Character:FindFirstChild("HumanoidRootPart")
        if newHRP then
            HRP = newHRP
        end
    end
    
    if isAttacking or not HRP or not HRP.Parent then
        task.wait(0.5)
        continue
    end
    
    local enemies = GetEnemies()
    
    for _, enemy in ipairs(enemies) do
        if not HRP or not HRP.Parent then break end
        
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local enemyHRP = GetHRP(enemy)
        
        if humanoid and humanoid.Health > 0 and enemyHRP then
            isAttacking = true
            SlideTo(enemy, HRP.Position)
            isAttacking = false
        end
    end
    
    task.wait(0.5)
end
