local function CreateDungeon()
    if not canCreateDungeon then
        print("⏭️ Création de donjon ignorée (Place ID incorrect)")
        return false
    end
    
    print("🚀 Création du donjon avec la configuration:")
    print("  📌 Nom:", Config.DUNGEON_NAME)
    print("  📌 Difficulté:", Config.DUNGEON_DIFFICULTY)
    print("  📌 Place ID:", Config.PLACE_ID)
    
    local LobbyRemotes = ReplicatedStorage:FindFirstChild("remotes")
    if not LobbyRemotes then
        print("❌ remotes introuvable")
        return false
    end
    
    local CreateLobby = LobbyRemotes:FindFirstChild("createLobby")
    if not CreateLobby then
        print("❌ createLobby introuvable")
        return false
    end
    
    local success, result = pcall(function()
        return CreateLobby:InvokeServer(
            Config.DUNGEON_NAME,
            Config.DUNGEON_DIFFICULTY,
            0,
            false,
            false,
            false
        )
    end)
    
    if success then
        print("✅ Donjon créé avec succès")
        return true
    else
        print("❌ Erreur lors de la création du donjon:", result)
        return false
    end
end

local function StartDungeonRemote()
    if not canCreateDungeon then
        print("⏭️ Démarrage de donjon ignoré (Place ID incorrect)")
        return false
    end
    
    print("🚀 Démarrage du donjon...")
    
    local LobbyRemotes = ReplicatedStorage:FindFirstChild("remotes")
    if not LobbyRemotes then
        print("❌ remotes introuvable")
        return false
    end
    
    local StartDungeon = LobbyRemotes:FindFirstChild("startDungeon")
    if not StartDungeon then
        print("❌ startDungeon introuvable")
        return false
    end
    
    pcall(function()
        StartDungeon:FireServer()
        print("✅ Donjon démarré")
    end)
    
    return true
end

