local CONFIG_PATH = "config_" .. GAME_ID .. ".json"

local DEFAULT_CONFIG = {
    dungeonName = "Winter Outpost",
    dungeonDifficulty = "Insane",
    gameId = GAME_ID
}

local function LoadConfig()
    local config = {
        DUNGEON_NAME = DEFAULT_CONFIG.dungeonName,
        DUNGEON_DIFFICULTY = DEFAULT_CONFIG.dungeonDifficulty,
        GAME_ID = GAME_ID
    }
    
    local configFile = "config_" .. GAME_ID .. ".json"
    
    if FileExists(configFile) then
        local content = ReadFile(configFile)
        if content then
            local success, decoded = pcall(function()
                return HttpService:JSONDecode(content)
            end)
            
            if success and decoded then
                print("✅ Configuration chargée depuis", configFile)
                if decoded.dungeonName then config.DUNGEON_NAME = decoded.dungeonName end
                if decoded.dungeonDifficulty then config.DUNGEON_DIFFICULTY = decoded.dungeonDifficulty end
                print("  📌 Dungeon Name:", config.DUNGEON_NAME)
                print("  📌 Dungeon Difficulty:", config.DUNGEON_DIFFICULTY)
                print("  📌 Game ID:", config.GAME_ID)
                return config
            end
        end
    end
    
    print("📝 Création du fichier", configFile, "...")
    local jsonString = HttpService:JSONEncode(DEFAULT_CONFIG)
    WriteFile(configFile, jsonString)
    print("✅ Fichier", configFile, "créé avec les valeurs par défaut")
    print("  📌 Dungeon Name:", config.DUNGEON_NAME)
    print("  📌 Dungeon Difficulty:", config.DUNGEON_DIFFICULTY)
    print("  📌 Game ID:", config.GAME_ID)
    
    return config
end

local Config = LoadConfig()

