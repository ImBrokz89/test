local function CheckStartButton()
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then 
        return false 
    end
    
    -- Chercher le bouton START
    local startButton = nil
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            startButton = gui:FindFirstChild("startButton")
            if startButton then break end
        end
    end
    
    if not startButton then
        startButton = PlayerGui:FindFirstChild("startButton")
    end
    
    if not startButton then
        return false
    end
    
    -- Vérifier si le bouton est visible/Enabled
    local isActive = false
    if startButton:IsA("ScreenGui") then
        isActive = startButton.Enabled
    elseif startButton:IsA("GuiObject") then
        isActive = startButton.Visible
    end
    
    -- Si le bouton est visible, lancer l'event
    if isActive then
        print("🟢 Bouton START visible ! Lancement de l'event...")
        
        local Remotes = ReplicatedStorage:FindFirstChild("remotes")
        if Remotes then
            local ChangeStartValue = Remotes:FindFirstChild("changeStartValue")
            if ChangeStartValue then
                pcall(function()
                    ChangeStartValue:FireServer()
                    print("✅ changeStartValue envoyé")
                end)
            end
        end
        
        return true
    else
        return false
    end
end

-- Vérifier une fois au début
