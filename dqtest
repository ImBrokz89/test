local function CreateConfigInWorkspace()
    print("📁 Création du dossier Omega.Win dans Workspace...")
    
    local omegaFolder = workspace:FindFirstChild("Omega.Win")
    if not omegaFolder then
        omegaFolder = Instance.new("Folder")
        omegaFolder.Name = "Omega.Win"
        omegaFolder.Parent = workspace
        print("✅ Dossier Omega.Win créé dans Workspace")
    else
        print("✅ Dossier Omega.Win déjà existant")
    end
    
    local defaultConfig = {
        dungeonName = "Pirate Island",
        dungeonDifficulty = "Insane"
    }
    
    local jsonString = FormatJSON(defaultConfig)
    
    print("📝 JSON généré:")
    print(jsonString)
    
    local configFile = omegaFolder:FindFirstChild("Config.json")
    if not configFile then
        configFile = Instance.new("StringValue")
        configFile.Name = "Config.json"
        configFile.Value = jsonString
        configFile.Parent = omegaFolder
        print("✅ Fichier Config.json créé dans Omega.Win")
    else
        configFile.Value = jsonString
        print("✅ Fichier Config.json mis à jour")
    end
    
    print("📋 Configuration:")
    print("  📌 Dungeon Name:", defaultConfig.dungeonName)
    print("  📌 Dungeon Difficulty:", defaultConfig.dungeonDifficulty)
    
    return defaultConfig
end

