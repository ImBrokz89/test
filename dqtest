    local CreateLobby = LobbyRemotes:FindFirstChild("createLobby")
    if not CreateLobby then
        print("❌ createLobby introuvable")
        return false
    end
    
    local success, result = pcall(function()
        return CreateLobby:InvokeServer(
            Config.DUNGEON_NAME,
            Config.DUNGEON_DIFFICULTY,
            0,
            false,
            false,
