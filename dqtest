local CONFIG_PATH = "config_" .. currentPlaceId .. ".json"

local DEFAULT_CONFIG = {
    dungeonName = "Winter Outpost",
    dungeonDifficulty = "Insane",
    placeId = currentPlaceId
}

local function LoadConfig()
    local config = {
        DUNGEON_NAME = DEFAULT_CONFIG.dungeonName,
        DUNGEON_DIFFICULTY = DEFAULT_CONFIG.dungeonDifficulty,
        PLACE_ID = currentPlaceId
    }
    
    if FileExists(CONFIG_PATH) then
        local content = ReadFile(CONFIG_PATH)
        if content then
            local success, decoded = pcall(function()
                return HttpService:JSONDecode(content)
            end)
            
            if success and decoded then
                print("✅ Configuration chargée depuis", CONFIG_PATH)
                if decoded.dungeonName then config.DUNGEON_NAME = decoded.dungeonName end
                if decoded.dungeonDifficulty then config.DUNGEON_DIFFICULTY = decoded.dungeonDifficulty end
                print("  📌 Dungeon Name:", config.DUNGEON_NAME)
                print("  📌 Dungeon Difficulty:", config.DUNGEON_DIFFICULTY)
                print("  📌 Place ID:", config.PLACE_ID)
                return config
            end
        end
    end
    
    print("📝 Création du fichier", CONFIG_PATH, "...")
    local jsonString = HttpService:JSONEncode(DEFAULT_CONFIG)
    WriteFile(CONFIG_PATH, jsonString)
    print("✅ Fichier", CONFIG_PATH, "créé avec les valeurs par défaut")
    print("  📌 Dungeon Name:", config.DUNGEON_NAME)
    print("  📌 Dungeon Difficulty:", config.DUNGEON_DIFFICULTY)
    print("  📌 Place ID:", config.PLACE_ID)
    
    return config
end

