-- LIRE LA CONFIGURATION DEPUIS LE DISQUE
--------------------------------------------------

local function LoadConfigFromDisk()
    local defaultConfig = {
        DUNGEON_NAME = "Pirate Island",
        DUNGEON_DIFFICULTY = "Insane",
        AUTO_REPLAY = false
    }
    
    if not FolderExists(CONFIG_FOLDER) then
        print("⚠️ Dossier " .. CONFIG_FOLDER .. " introuvable, création...")
        return CreateConfigOnDisk()
    end
    
    if not FileExists(CONFIG_FILE) then
        print("⚠️ Fichier Config.json introuvable, création...")
        return CreateConfigOnDisk()
    end
    
    local content = ReadFile(CONFIG_FILE)
    if not content then
        print("❌ Impossible de lire le fichier Config.json")
        return CreateConfigOnDisk()
    end
    
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    
    if success and decoded then
        print("✅ Configuration chargée depuis " .. CONFIG_FILE)
        print("📋 Contenu du fichier:")
        print(content)
        
        if decoded.dungeonName then 
            defaultConfig.DUNGEON_NAME = decoded.dungeonName 
        end
        if decoded.dungeonDifficulty then 
            defaultConfig.DUNGEON_DIFFICULTY = decoded.dungeonDifficulty 
        end
        if decoded.AutoReplay ~= nil then
            defaultConfig.AUTO_REPLAY = decoded.AutoReplay
        end
        
        print("  📌 Dungeon Name:", defaultConfig.DUNGEON_NAME)
        print("  📌 Dungeon Difficulty:", defaultConfig.DUNGEON_DIFFICULTY)
        print("  📌 AutoReplay:", defaultConfig.AUTO_REPLAY)
    else
        print("❌ Erreur de lecture du JSON, utilisation des valeurs par défaut")
        print("📝 Contenu actuel du fichier:", content)
        return CreateConfigOnDisk()
    end
    
    return defaultConfig
end

