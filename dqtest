local DUNGEON_NAME = "Winter Outpost"
local DUNGEON_DIFFICULTY = "Medium"

--------------------------------------------------
-- FONCTION POUR DÉMARRER LE DONJON (CORRIGÉE)
--------------------------------------------------

local function StartDungeon()
    print("🚀 Tentative de démarrage du donjon...")
    
    local LobbyRemotes = ReplicatedStorage:FindFirstChild("remotes")
    if not LobbyRemotes then
        print("❌ remotes introuvable")
        return false
    end
    
    -- Créer le lobby
    local CreateLobby = LobbyRemotes:FindFirstChild("createLobby")
    if CreateLobby then
        local success, result = pcall(function()
            return CreateLobby:InvokeServer(
                DUNGEON_NAME,
                DUNGEON_DIFFICULTY,
                0,
                false,
                false,
                false
            )
        end)
        if success then
            print("✅ Lobby créé avec succès")
        else
            print("❌ Erreur lors de la création du lobby:", result)
            return false
        end
    else
        print("❌ createLobby introuvable")
        return false
    end
    
    task.wait(2)
    
    -- Démarrer le donjon
    local StartDungeonRemote = LobbyRemotes:FindFirstChild("startDungeon")
    if StartDungeonRemote then
        pcall(function()
            StartDungeonRemote:FireServer()
            print("✅ Donjon démarré")
        end)
        return true
    else
        print("❌ startDungeon introuvable")
        return false
    end
end

--------------------------------------------------
-- SURVEILLER LE BOUTON START
--------------------------------------------------

local function CheckAndStart()
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then 
        print("❌ PlayerGui introuvable")
        return false 
    end
    
    -- Chercher le bouton START dans tous les ScreenGui
    local startButton = nil
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            startButton = gui:FindFirstChild("startButton")
            if startButton then
                break
            end
        end
    end
    
    -- Si pas trouvé, chercher directement
    if not startButton then
        startButton = PlayerGui:FindFirstChild("startButton")
    end
    
    if not startButton then
        print("ℹ️ startButton introuvable, le donjon est peut-être déjà démarré")
        return false
    end
    
    -- Vérifier si le bouton est visible/activé
    local isVisible = false
    if startButton:IsA("ScreenGui") then
        isVisible = startButton.Enabled
    elseif startButton:IsA("GuiObject") then
        isVisible = startButton.Visible
    end
    
    if isVisible then
        print("🟢 Bouton START détecté et visible !")
        
        -- Cliquer sur le bouton (simuler un clic)
        if startButton:IsA("TextButton") or startButton:IsA("ImageButton") then
            pcall(function()
                startButton:Click()
                print("✅ Clic sur le bouton START effectué")
            end)
        end
        
        -- Alternativement, utiliser les remotes
        local Remotes = ReplicatedStorage:FindFirstChild("remotes")
        if Remotes then
            local ChangeStartValue = Remotes:FindFirstChild("changeStartValue")
            if ChangeStartValue then
                pcall(function()
                    ChangeStartValue:FireServer()
                    print("✅ changeStartValue envoyé")
                end)
            end
        end
        
        task.wait(2)
        return true
    else
        print("🔴 Bouton START non visible ou désactivé")
        return false
    end
end

