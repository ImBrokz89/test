    if not HRP or not HRP.Parent then return end
    if not enemyPosition then return end
    
    local distance = (HRP.Position - enemyPosition).Magnitude
    if distance > SWING_RANGE then return end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    
    local abilityUsed = ReplicatedStorage:FindFirstChild("remotes")
    if abilityUsed then
        abilityUsed = abilityUsed:FindFirstChild("abilityUsed")
    end
    if not abilityUsed then return end
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local abilitySlot = tool:FindFirstChild("abilitySlot")
            
            if abilitySlot then
                local slot = string.lower(tostring(abilitySlot.Value))
                
                if slot == "q" or slot == "e" then
                    local cooldown = tool:FindFirstChild("cooldown")
                    local ready = true
                    if cooldown then
                        local value = cooldown.Value
                        if cooldown:IsA("BoolValue") then
                            ready = value == false
                        elseif typeof(value) == "number" then
                            ready = value <= 0
                        end
                    end
                    
                    if ready then
                        pcall(function()
                            abilityUsed:FireServer(slot, tool)
                            
                            local spellEvent = tool:FindFirstChild("spellEvent")
                            if spellEvent and spellEvent:IsA("RemoteEvent") then
                                spellEvent:FireServer()
                            end
                            
                            local abilityEvent = tool:FindFirstChild("abilityEvent")
                            if abilityEvent and abilityEvent:IsA("RemoteEvent") then
                                abilityEvent:FireServer()
                            end
                        end)
                    end
                end
            end
        end
    end
end

--------------------------------------------------
-- SE DÉPLACER VERS L'ENNEMI
--------------------------------------------------

local function SlideTo(enemy, startPos)
    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
    local enemyHRP = GetHRP(enemy)
    
    if not humanoid or humanoid.Health <= 0 then return end
    if not enemyHRP then return end
    if not HRP or not HRP.Parent then return end

    local playerHumanoid = Character:FindFirstChildOfClass("Humanoid")
    if not playerHumanoid then return end
    
    local walkSpeed = SLIDE_SPEED
    local originalWalkSpeed = playerHumanoid.WalkSpeed
    playerHumanoid.WalkSpeed = walkSpeed

    local pos = startPos
    local swingTimer = 0
    local stuckTime = 0
    local heartbeat = RunService.Heartbeat
    local spellTimer = 0
    local spellDelay = 0.15

    while true do
        if not HRP or not HRP.Parent then break end
        
        humanoid = enemy:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then 
            break
        end
        
        enemyHRP = GetHRP(enemy)
        if not enemyHRP then break end
        
        local targetPos = enemyHRP.Position + Vector3.new(0, Offset, 0)
        local distance = (targetPos - pos).Magnitude
        local distanceToEnemy = (HRP.Position - enemyHRP.Position).Magnitude
        
        local dt = heartbeat:Wait()
        
        if distance > 0.5 then
            local speed = walkSpeed * 2.2
            local step = math.min(1, speed * dt / distance)
            pos = pos:Lerp(targetPos, step)
            stuckTime = 0
        else
            stuckTime = stuckTime + dt
        end
        
        SetProne(pos, enemyHRP.Position)
        
        if distanceToEnemy <= SWING_RANGE then
            swingTimer = swingTimer + dt
            if swingTimer >= SwingDelay then
                SwingWeapon()
                swingTimer = 0
            end
            
            spellTimer = spellTimer + dt
            if spellTimer >= spellDelay then
                UseSpellsDuringSlide(enemyHRP.Position)
                spellTimer = 0
            end
        end
        
        if stuckTime >= 5 then
            break
        end
    end
    
    playerHumanoid.WalkSpeed = originalWalkSpeed
end

--------------------------------------------------
-- BOUCLE PRINCIPALE
--------------------------------------------------

while true do
    local currentChar = LocalPlayer.Character
    if currentChar then
        Character = currentChar
        local newHRP = Character:FindFirstChild("HumanoidRootPart")
        if newHRP then
            HRP = newHRP
        end
    end
    
    if isAttacking or not HRP or not HRP.Parent then
        task.wait(0.5)
        continue
    end
    
    local enemies = GetEnemies()
    
    for _, enemy in ipairs(enemies) do
        if not HRP or not HRP.Parent then break end
        
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local enemyHRP = GetHRP(enemy)
        
        if humanoid and humanoid.Health > 0 and enemyHRP then
            isAttacking = true
            SlideTo(enemy, HRP.Position)
            isAttacking = false
        end
    end
    
    task.wait(0.5)
end
