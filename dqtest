-- FONCTIONS DE LECTURE/ÉCRITURE DE FICHIER
--------------------------------------------------

local function FileExists(filename)
    if isfile then
        return isfile(filename)
    end
    return false
end

local function ReadFile(filename)
    if isfile then
        return readfile(filename)
    end
    return nil
end

local function WriteFile(filename, content)
    if writefile then
        writefile(filename, content)
        return true
    end
    return false
end

local function FolderExists(folderPath)
    if isfolder then
        return isfolder(folderPath)
    end
    return false
end

local function CreateFolder(folderPath)
    if makefolder then
        makefolder(folderPath)
        return true
    end
    return false
end

--------------------------------------------------
-- FONCTION POUR FORMATER LE JSON
--------------------------------------------------

local function FormatJSON(data)
    local json = HttpService:JSONEncode(data)
    
    json = string.gsub(json, "{", "{\n  ")
    json = string.gsub(json, "}", "\n}")
    json = string.gsub(json, ",", ",\n  ")
    json = string.gsub(json, "\n  \n", "\n")
    
    return json
end

